{
  "indentation": {
    "spaces": 4
  },
  "lineLength": 120,
  "multiElementCollectionTrailingCommas": false,
  "rules": {
    "AlwaysUseLowerCamelCase": false,
    "NoAccessLevelOnExtensionDeclaration": false,
    "NoBlockComments": false,
    "ReplaceForEachWithForLoop": false
  },
  "tabWidth": 4,
  "version": 1
}
